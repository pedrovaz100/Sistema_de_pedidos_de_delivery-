# Copy this file to ".env" in the delivery-system root (it is ignored by git).
# Values must not be quoted. The order-service reads it automatically on startup.
# Real environment variables always work too (and win over this file).

# Option 1 - OpenAI
OPENAI_API_KEY=put-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option 2 - LM Studio (local server, any non-empty key works)
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=the-model-identifier-shown-in-lm-studio

# Option 3 - Ollama (OpenAI compatible endpoint, any non-empty key works)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
